{
  "kind": "save_audio",
  "title": "Save Audio",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "audio_in",
        "title": "Audio in",
        "accepts": [
          "audio/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": [
            "opus",
            "aac"
          ],
          "sample_rates_hz": [],
          "channels": [
            1,
            2
          ],
          "overflow_policy": "drop_oldest"
        }
      },
      {
        "id": 2,
        "name": "command_in",
        "title": "Command in",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": true,
        "execution_requirement": "required_for_execution",
        "transport": "message"
      }
    ],
    "outputs": []
  },
  "config": {
    "output_dir": "exports/audio-streams",
    "filename_template": "audio_{timestamp}_{stream_id}",
    "idle_finalize_sec": 1.5
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false,
    "allow_required_input": false,
    "default_required": false,
    "max_inputs": 2,
    "max_outputs": 0,
    "default_input_accepts": [
      "audio/*"
    ],
    "default_output_emits": [
      "message/*"
    ],
    "default_multiplicity": "one"
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": false,
    "file_browser": true,
    "centralized_executor": "generic",
    "supports_runtime_audio_streams": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      }
    ]
  }
}
